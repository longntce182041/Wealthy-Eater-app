{
  "name": "UC-41 Detect Pantry",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "detect-pantry",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "faa9d5db-578e-4208-b30d-d38e3704ac9c",
      "name": "Receive Refrigerator Image",
      "webhookId": "uc41-detect-pantry-webhook-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "AIzaSyCP5gfUpq_kMQPzG3PcT-W3EH8vs-e8Rgg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [\n    {\n      parts: [\n        {\n          text: \"You are an expert food storage inspector. Analyse the provided image of a refrigerator interior. Your goal is to provide a list of raw food ingredients visible.\\n\\nTask:\\n1. Identify raw food items (e.g., 'carrots', 'chicken breast', 'apple', 'milk').\\n2. Strict Noise Filtering: Completely ignore non-food items, containers, packaging, bottles (unless the food itself is a liquid like milk/juice), boxes, plastic bags, or refrigerator shelves. Do not list 'plastic bottle' or 'tupperware'. Only list the food inside if visible, otherwise ignore it.\\n3. Estimate realistic quantities based on visual size.\\n\\nOutput Format:\\nReturn your answer strictly matching the JSON schema.\"\n        },\n        {\n          inline_data: {\n            mime_type: $json.body.mime_type || 'image/jpeg',\n            data: $json.body.image_base64\n          }\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    responseMimeType: \"application/json\",\n    responseSchema: {\n      type: \"ARRAY\",\n      items: {\n        type: \"OBJECT\",\n        properties: {\n          name: { type: \"STRING\" },\n          quantity: { type: \"NUMBER\" },\n          unit: { type: \"STRING\" }\n        },\n        required: [\"name\", \"quantity\", \"unit\"]\n      }\n    }\n  }\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        250,
        0
      ],
      "id": "ef96708f-cd61-4cac-9fcf-fe070734e27e",
      "name": "Gemini Vision - Detect Food",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "check-error",
              "leftValue": "={{ $json.error != undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        500,
        0
      ],
      "id": "if-gemini-error",
      "name": "Check Gemini Error"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  success: false,\n  message: 'AI Service is temporarily unavailable or failed to process the image.',\n  error_details: $json.error\n}) }}",
        "options": {
          "responseCode": 503
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        750,
        200
      ],
      "id": "respond-gemini-error",
      "name": "Respond - Gemini Error"
    },
    {
      "parameters": {
        "jsCode": "try {\n  const aiOutputText = $input.first().json.candidates[0].content.parts[0].text;\n  const foodArray = JSON.parse(aiOutputText);\n  const userId = $('Receive Refrigerator Image').first().json.body.user_id || '';\n\n  return [{ \n    json: { \n      success: true,\n      user_id: userId,\n      p_raw_inventory: foodArray,\n      detected_count: foodArray.length,\n      detected_at: new Date().toISOString()\n    } \n  }];\n} catch (e) {\n  return [{ json: { success: false, p_raw_inventory: [], error: 'Failed to parse JSON schema output: ' + e.message } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        -100
      ],
      "id": "5e609b77-7d61-4144-a73e-300ea9295474",
      "name": "Extract JSON Items"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "uc41-cond-userid-check",
              "leftValue": "={{$json.user_id}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "uc41-cond-success-check",
              "leftValue": "={{$json.success}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1000,
        -100
      ],
      "id": "f95c04f1-f649-4194-b9d1-dc6a0e0bc6b8",
      "name": "Validate Before DB Sync"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Pantry inventory detected successfully.', inventory: $json.p_raw_inventory, detected_count: $json.detected_count, scanned_at: $json.detected_at }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1250,
        -200
      ],
      "id": "c4642af2-f28a-4531-b18c-7fdaa06d5b63",
      "name": "Respond — Pantry Sync Success"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, message: 'Validation failed. Ensure user_id is provided and image was processed successfully.', error_details: { user_id: $json.user_id || null, ai_success: $json.success || false, parsing_error: $json.error } }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1250,
        0
      ],
      "id": "517ed199-f908-4cd4-abe7-abbd423f6422",
      "name": "Respond — Validation Error"
    }
  ],
  "connections": {
    "Receive Refrigerator Image": {
      "main": [
        [
          {
